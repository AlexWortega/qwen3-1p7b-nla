# Copy to .env and fill in. Never commit .env (it is in .gitignore).

# OpenRouter — used for all teacher summary generation (bulk + eval).
# Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...

# Weights & Biases — required for all training/eval runs.
# Get one at https://wandb.ai/authorize
WANDB_API_KEY=...
WANDB_PROJECT=vae-llm-nla
WANDB_ENTITY=

# HuggingFace — needed to download Qwen3 weights (Qwen3 is gated for some users).
HF_TOKEN=

# claude-monitor-sdk — wandb-style logger that mirrors all training metrics
# alongside (or in place of) wandb. Get a key at the claude-monitor dashboard.
CLAUDE_MONITOR_API_KEY=ba_...
CM_PROJECT=vae-llm-nla
